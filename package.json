{
  "name": "government-job-postings",
  "version": "1.0.0",
  "description": "Hybrid web scraping + AI parsing pipeline for Indian government job portals",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync": "node -e \"import('./services/pipeline.js').then(m => m.runFullSync())\"",
    "postinstall": "npx playwright install chromium"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.49.1"
  }
}
